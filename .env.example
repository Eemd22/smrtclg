# ============== TiDB Cloud Starter (الإنتاج) ==============
MYSQL_HOST=gateway01.xxxxx.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_USER=<prefix>.root
MYSQL_PASSWORD=your-tidb-password
MYSQL_DATABASE=smart_college
MYSQL_SSL=true
MYSQL_SSL_STRICT=false
MYSQL_CONNECTION_LIMIT=5

# ============== Local Development ==============
# للتطوير المحلي، استخدم هذه القيم:
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=smart_college
# MYSQL_SSL=false
# MYSQL_CONNECTION_LIMIT=10

# ============== Application ==============
JWT_SECRET=your-secret-key-here
PORT=3000
BOOTSTRAP_ADMIN_EMAIL=emad@gmail.com

# ============== OpenAI ==============
OPENAI_API_KEY=sk-proj-xxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
